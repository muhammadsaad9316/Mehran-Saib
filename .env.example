# Development defaults: local JSON persistence, demo data, localhost binding.
PORT=3001
HOST=127.0.0.1
LABTRACK_DEMO=true
# LABTRACK_DATA_DIR=C:/path/to/private/labtrack-data
# MONGODB_URI=mongodb://127.0.0.1:27017/labtrack
# Supabase is the selected hosted database. Configure both values on the backend.
# Apply ALL committed Supabase migrations in order before connecting.
# See docs/supabase.md for reconciled hosted history and all required migrations.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=server-only-key
# CLIENT_ORIGIN=http://localhost:5173

# Fresh production database: set NODE_ENV=production, LABTRACK_DEMO=false,
# ADMIN_EMAIL and a unique ADMIN_PASSWORD of at least 12 characters.
# Production must use HTTPS because session cookies are Secure.
# NODE_ENV=production
# ADMIN_EMAIL=teacher@your-university.edu
# ADMIN_NAME=Your Teacher
# ADMIN_PASSWORD=replace-with-a-long-unique-password
