{
  "name": "labtrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --watch-path=./server --watch-path=./shared --watch-path=./.env --import tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo:analysis": "tsx server/analysis-demo.ts",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "prepare:class": "tsx server/class-setup.ts --prepare",
    "provision:class": "tsx server/class-setup.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.13",
    "acorn": "^8.15.0",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "css-tree": "^3.1.0",
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/css-tree": "^2.3.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
